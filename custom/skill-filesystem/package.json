{
  "name": "dsh-custom-skill-filesystem",
  "description": "Custom fork of the local skill provider: adds includeSources and excludeNames filtering",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./invariant": {
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-fs": "workspace:^",
    "@deepseek-ai/dsh-home-paths": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-settings": "workspace:^",
    "@deepseek-ai/dsh-skill": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "chokidar": "^4.0.0",
    "yaml": "^2.0.0"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js"
  ]
}
